# Drop Server & Database Configuration
POSTGRES_USER=drop
POSTGRES_PASSWORD=drop
DATABASE_URL=postgres://drop:drop@172.20.0.21:5432/drop
EXTERNAL_URL=http://localhost:3000/

# Optional: Fast-tier chunk cache on local NVMe/SSD
# Content-addressed read-through cache keyed by plaintext SHA-256
CHUNK_CACHE_DIR=/cache
CHUNK_CACHE_MAX_BYTES=53687091200

# Optional: IGDB Metadata Provider
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
