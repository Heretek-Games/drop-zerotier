{
  "name": "drop-zerotier",
  "version": "0.3.0",
  "private": true,
  "description": "Virtual mesh network provider plugin (ZTNET / ZeroTier / Tailscale) for the Drop gaming platform",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bundle:build": "drop-plugin build plugin-bundle",
    "validate": "drop-plugin validate plugin-bundle",
    "sign": "drop-plugin sign plugin-bundle",
    "pack": "drop-plugin pack plugin-bundle dist-packages",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@droposs/plugin-cli": "file:../drop-plugin-sdk/packages/plugin-cli",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22"
  }
}
