[Unit]
Description=Drop ZeroTier Controller Data Plane
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=drop-zerotier
Image=docker.io/zyclonite/zerotier:latest
AutoUpdate=registry
Network=drop-network.network
IP=172.20.0.30
PublishPort=9994:9994/udp
AddCapability=NET_ADMIN SYS_ADMIN
AddDevice=/dev/net/tun:/dev/net/tun
Volume=drop-zerotier.volume:/var/lib/zerotier-one
Environment=ZT_OVERRIDE_LOCAL_CONF=true
Environment=ZT_PRIMARY_PORT=9994
Environment=ZT_ALLOW_MANAGEMENT_FROM=172.20.0.0/16
SecurityLabelDisable=true

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
