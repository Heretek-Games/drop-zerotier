# Secrets for compose.ztnet.yaml. Copy to .env.ztnet and fill in.
#
#   cp .env.ztnet.example .env.ztnet

# Signs ZTNET sessions/tokens. Generate once and keep it:
#   echo "NEXTAUTH_SECRET=$(openssl rand -hex 32)" >> .env.ztnet
NEXTAUTH_SECRET=

# Canonical URL of the ZTNET UI (must match how the browser reaches it).
NEXTAUTH_URL=http://localhost:3001

# Create these in the ZTNET UI (see compose.ztnet.yaml header):
#   Organization -> copy id; Account settings -> create an API token.
GSE_ZTNET_ORG=
GSE_ZTNET_TOKEN=
